HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://user:password@host:5432/database
VAPID_PUBLIC_KEY=replace_with_your_public_key
VAPID_PRIVATE_KEY=replace_with_your_private_key
VAPID_SUBJECT=mailto:you@example.com
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_signing_secret
STRIPE_PRICE_MONTHLY=price_replace_with_your_monthly_price_id
STRIPE_PRICE_ANNUAL=price_replace_with_your_annual_price_id
STRIPE_RETURN_ORIGIN=https://denver-curb-alerts-2.onrender.com
# Transactional email, for address confirmation and password reset. Both are unset by default,
# which leaves those endpoints answering 503 and the client hiding the controls — the app is fully
# usable without them. Real sending needs a domain verified at Resend; EMAIL_FROM must be on it.
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=Denver Curb Alerts <alerts@yourdomain.com>
# Set to "outbox" to run the whole flow locally with no provider: messages are written to
# data/outbox.json and you click the link out of the file. This is also what the tests use.
EMAIL_TRANSPORT=
