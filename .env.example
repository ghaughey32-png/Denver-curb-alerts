HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://user:password@host:5432/database
VAPID_PUBLIC_KEY=replace_with_your_public_key
VAPID_PRIVATE_KEY=replace_with_your_private_key
VAPID_SUBJECT=mailto:you@example.com
# The canonical origin this app is served from. Verify and reset links are built from it, and it is
# trusted with a session cookie. Setting it is how a new domain is adopted.
APP_ORIGIN=https://denver-curb-alerts-2.onrender.com
# Extra origins allowed to send a session cookie, comma-separated, scheme and host only. Only needed
# for an origin that is not APP_ORIGIN — a staging deploy, or both hostnames during a domain
# cutover. localhost:3000 and the current Render subdomain are always trusted without being listed.
CREDENTIALED_ORIGINS=
# Transactional email, for address confirmation and password reset. Both are unset by default,
# which leaves those endpoints answering 503 and the client hiding the controls — the app is fully
# usable without them. Real sending needs a domain verified at Resend; EMAIL_FROM must be on it.
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=Denver Curb Alerts <alerts@yourdomain.com>
# Set to "outbox" to run the whole flow locally with no provider: messages are written to
# data/outbox.json and you click the link out of the file. This is also what the tests use.
EMAIL_TRANSPORT=
# Gates every bulk read that returns other people's records, including the push subscription keys.
# Unset closes those endpoints, which is the safe default.
ISSUE_REPORT_ADMIN_TOKEN=
# Where the JSON collections live when DATABASE_URL is unset. Defaults to ./data.
DATA_DIR=
